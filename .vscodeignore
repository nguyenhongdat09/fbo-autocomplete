# Loại bỏ thư mục không cần thiết
.vscode/**
.vscode-test/**
test/**
test_*.js
debug-*.log
_vsix_inspect/**

# Không ship toàn bộ node_modules thô — vsce tự lấy production deps.
# (build-package.js prune còn sót thì vẫn loại junk native/build.)
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/docs/**
node_modules/**/*.md
node_modules/**/*.map
node_modules/rocksdb/deps/**
node_modules/rocksdb/build/**

# Dev / IDE / công cụ nội bộ — không ship trong VSIX
.codegraph/**
.codegraph-*/
.cursor/**
scripts/**
build-package.js
debug.log
PivotExcel/**
*.vsix

# Loại bỏ file cấu hình và metadata
.git/**
.gitignore
.yarnrc
package-lock.json
package.json.__fbo_writing__
package-lock.json.__fbo_packaging__
webpack.config.js
tsconfig.json
eslint.config.mjs
.vscode-test.*
vsc-extension-quickstart.md

# Loại bỏ file map (nếu có)
**/*.map

# Chỉ ship bundle + asset runtime (không lộ toàn bộ source .js)
src/**
!src/dist/**
!src/ReadXML/ReadXML.exe
!src/ReadXML/Newtonsoft.Json.Compact.dll
!src/ReadXML/Newtonsoft.Json.Compact.xml
!src/HighLightSyntax/syntaxes/**
!src/DBQuery/media/**
!src/DBQuery/GenerateProcessing.js
!src/DBQuery/GenerateHeaderToReport.js
!src/ReadXMLByJS/XmlFlatPreview/media/**
!src/ReadXMLByJS/CheckingError/media/**


# Database: chỉ template/runtime cần thiết (không ship LevelDB/cache máy dev)
!src/Database/AutoComplete/**
!src/Database/XSD/**
!src/Database/PivotExcelExe/**
!src/Database/fbo-license.dat
!src/Database/extension_for_format.js
!src/Database/mau_chuan.xlsx
!src/Database/Json Set Mau .txt
!src/Database/autocompletesheet-*.json

# Loại bỏ các file JSON config không cần thiết
**/jsconfig.json
