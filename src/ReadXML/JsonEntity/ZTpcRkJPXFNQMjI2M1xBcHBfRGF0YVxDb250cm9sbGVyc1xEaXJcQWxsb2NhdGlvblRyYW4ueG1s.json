[{"Name":"ManagementObjectCheck","Content":"\r\nselect sum(case when ma_vv = '' then 0 else 1 end) as vv, sum(case when ma_bp = '' then 0 else 1 end) as bp, sum(case when ma_hd = '' then 0 else 1 end) as hd into #g from @dmpb1\r\nif exists(select 1 from #g where (case when vv &gt; 0 then 1 else 0 end + case when bp &gt; 0 then 1 else 0 end + case when hd &gt; 0 then 1 else 0 end) &gt; 1) begin\r\n  select 'stt' as field, case when @@language = 'v' then N'Chỉ được chọn một tiêu thức phân bổ trong các đối tượng &lt;span class=\"Highlight\"&gt;vụ việc&lt;/span&gt;&Tiny.External.ManagementObject.Field.ContractAndDepartment.Html.v;.' else N'Only one to choose allocation criteria.' end as message\r\n  return\r\nend\r\nif exists(select 1 from (select count(*) as n from @dmpb1 group by tk, ma_vv, ma_bp, ma_hd) a where n &gt; 1) begin\r\n  select 'stt' as field, case when @@language = 'v' then N'Kiểm tra lại trong chi tiết có tài khoản, vụ việc&Tiny.External.ManagementObject.Field.ContractAndDepartment.v; nhập hơn một lần.' else N'Invalid account, job&Tiny.External.ManagementObject.Field.ContractAndDepartment.e;, it already exists..' end as message\r\n  return\r\nend\r\n"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.Html.v","Content":", &lt;span class=\"Highlight\"&gt;bộ phận&lt;/span&gt; hoặc &lt;span class=\"Highlight\"&gt;hợp đồng&lt;/span&gt;"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.v","Content":", bộ phận và hợp đồng"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.e","Content":", department or contract code"},{"Name":"Calc","Content":"\r\ndeclare @job bit, @department bit, @contract bit\r\nselect @job = 0, @department = 0, @contract = 0\r\nif exists(select 1 from @dmpb1 where ma_vv &lt;&gt; '') select @job = 1\r\nif exists(select 1 from @dmpb1 where ma_bp &lt;&gt; '') select @department = 1\r\nif exists(select 1 from @dmpb1 where ma_hd &lt;&gt; '') select @contract = 1\r\n"},{"Name":"ManagementObjectCheck","Content":"\r\nselect sum(case when ma_vv = '' then 0 else 1 end) as vv, sum(case when ma_bp = '' then 0 else 1 end) as bp, sum(case when ma_hd = '' then 0 else 1 end) as hd into #g from @dmpb1\r\nif exists(select 1 from #g where (case when vv &gt; 0 then 1 else 0 end + case when bp &gt; 0 then 1 else 0 end + case when hd &gt; 0 then 1 else 0 end) &gt; 1) begin\r\n  select 'stt' as field, case when @@language = 'v' then N'Chỉ được chọn một tiêu thức phân bổ trong các đối tượng &lt;span class=\"Highlight\"&gt;vụ việc&lt;/span&gt;&Tiny.External.ManagementObject.Field.ContractAndDepartment.Html.v;.' else N'Only one to choose allocation criteria.' end as message\r\n  return\r\nend\r\nif exists(select 1 from (select count(*) as n from @dmpb1 group by tk, ma_vv, ma_bp, ma_hd) a where n &gt; 1) begin\r\n  select 'stt' as field, case when @@language = 'v' then N'Kiểm tra lại trong chi tiết có tài khoản, vụ việc&Tiny.External.ManagementObject.Field.ContractAndDepartment.v; nhập hơn một lần.' else N'Invalid account, job&Tiny.External.ManagementObject.Field.ContractAndDepartment.e;, it already exists..' end as message\r\n  return\r\nend\r\n"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.Html.v","Content":", &lt;span class=\"Highlight\"&gt;bộ phận&lt;/span&gt; hoặc &lt;span class=\"Highlight\"&gt;hợp đồng&lt;/span&gt;"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.v","Content":", bộ phận và hợp đồng"},{"Name":"Tiny.External.ManagementObject.Field.ContractAndDepartment.e","Content":", department or contract code"},{"Name":"Calc","Content":"\r\ndeclare @job bit, @department bit, @contract bit\r\nselect @job = 0, @department = 0, @contract = 0\r\nif exists(select 1 from @dmpb1 where ma_vv &lt;&gt; '') select @job = 1\r\nif exists(select 1 from @dmpb1 where ma_bp &lt;&gt; '') select @department = 1\r\nif exists(select 1 from @dmpb1 where ma_hd &lt;&gt; '') select @contract = 1\r\n"},{"Name":"Tiny.External.ConfigEvent","Conten