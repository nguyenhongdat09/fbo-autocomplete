    "tien_nt2": { "name": "tien_nt2", "header_v": "Tiền hàng nt", "header_e": "FC Amount", "source": "grid", "type": "decimal", "hidden": false, "read_only": false, "group": "amount" },
    "tien2": { "name": "tien2", "header_v": "Tiền", "header_e": "Amount", "source": "grid", "type": "decimal", "hidden": false, "read_only": false, "group": "amount" },
