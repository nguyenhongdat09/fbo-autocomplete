    "phi_dvtn_yn": { "name": "phi_dvtn_yn", "header_v": "Phí DV-TN", "header_e": "DV-TN Fee", "source": "grid", "type": "boolean", "hidden": false, "read_only": false, "group": "fee" },
    "tien_mthang_nt": { "name": "tien_mthang_nt", "header_v": "Tiền + Phí MT nt ", "header_e": "EPC", "source": "grid", "type": "decimal", "hidden": true, "read_only": false, "group": "fee" },
    "ty_gia": { "name": "ty_gia", "header_v": "Tỷ giá", "header_e": "Ex. Rate", "source": "master", "type": "decimal", "hidden": false, "read_only": false, "group": "master" },
    "t_ck_nt": { "name": "t_ck_nt", "header_v": "Tiền chiết khấu", "header_e": "Discount Amount", "source": "master", "type": "decimal", "hidden": false, "read_only": true, "group": "master" },
    "t_tt_nt": { "name": "t_tt_nt", "header_v": "Tổng thanh toán", "header_e": "Total", "source": "master", "type": "decimal", "hidden": false, "read_only": true, "group": "master" }
  },
  "entries": [
    {
      "alias": "tien_nt2_sl",
      "kind": "formula",
      "raw": "[tien_nt2]:=[so_luong]*[gia_nt]",
      "target": "tien_nt2",
      "formula": "[so_luong]*[gia_nt]",
      "plain_vi": "Tiền hàng nt = Số lượng × Giá nt",
      "refs": ["so_luong", "gia_nt"],
      "group": "amount"
    },
    {
      "alias": "tien2",
      "kind": "formula",
      "raw": "[tien2]:=[tien_nt2]*[$ty_gia]",
      "target": "tien2",
      "formula": "[tien_nt2]*[$ty_gia]",
      "plain_vi": "Tiền = Tiền hàng nt × Tỷ giá",
      "refs": ["tien_nt2", "ty_gia"],
      "group": "amount"
    },
    {
      "alias": "ck_nt",
      "kind": "formula",
      "raw": "[ck_nt]:=[tien_nt2]*[tl_ck]/100",
      "target": "ck_nt",
      "formula": "[tien_nt2]*[tl_ck]/100",
      "plain_vi": "Chiết khấu nt = Tiền hàng nt × Tỷ lệ chiết khấu (%) / 100",
      "refs": ["tien_nt2", "tl_ck"],
      "group": "discount"
    },
    {
      "alias": "thue_nt",
      "kind": "formula",
      "raw": "[thue_nt]:=([tien_nt2] - [ck_nt])*[thue_suat]/100",
      "target": "thue_nt",
      "formula": "([tien_nt2] - [ck_nt])*[thue_suat]/100",
      "plain_vi": "Thuế nt = (Tiền hàng nt − Chiết khấu nt) × Thuế suất / 100",
      "refs": ["tien_nt2", "ck_nt", "thue_suat"],
      "group": "tax"
    },
    {
      "alias": "tien_mthang_nt",
      "kind": "formula",
      "raw": "[tien_mthang_nt]:=([phi_dvtn_yn] == 0 ? [tien_nt2] : 0)",
      "target": "tien_mthang_nt",
      "formula": "([phi_dvtn_yn] == 0 ? [tien_nt2] : 0)",
      "plain_vi": "Nếu không tick Phí DV-TN thì lấy Tiền hàng nt, không thì 0",
      "refs": ["phi_dvtn_yn", "tien_nt2"],
      "group": "fee"
    },
    {
      "alias": "t_ck_nt",
      "kind": "aggregate",
      "raw": "['t_ck_nt', 'ck_nt']",
      "master": "t_ck_nt",
      "grid_col": "ck_nt",
      "plain_vi": "Cộng dồn Chiết khấu nt trên lưới thành Tiền chiết khấu trên phiếu",
      "refs": ["ck_nt"],
      "group": "master"
    },
    {
      "alias": "t_tt_nt",
      "kind": "formula",
      "raw": "[t_tt_nt]:=[t_tien_nt2]-[t_ck_nt]+[t_thue_nt]+[t_thue_dvtn_nt]",
      "target": "t_tt_nt",
      "formula": "[t_tien_nt2]-[t_ck_nt]+[t_thue_nt]+[t_thue_dvtn_nt]",
      "plain_vi": "Tổng thanh toán nt = Tổng tiền nt − Tiền chiết khấu + Thuế nt + Tổng thuế DVTN nt",
      "refs": ["t_tien_nt2", "t_ck_nt", "t_thue_nt", "t_thue_dvtn_nt"],
      "group": "master"
    }
  ],
