    "ck_nt": { "name": "ck_nt", "header_v": "Chiết khấu nt", "header_e": "FC Discount Amount", "source": "grid", "type": "decimal", "hidden": false, "read_only": false, "group": "discount" },
    "ck": { "name": "ck", "header_v": "Chiết khấu", "header_e": "Discount Amount", "source": "grid", "type": "decimal", "hidden": false, "read_only": false, "group": "discount" },
