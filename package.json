{
  "name": "fbo-autocomplete",
  "displayName": "fbo-autocomplete",
  "description": "Complete the code xml base on my own experience",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenhongdat09/fbo-autocomplete.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./extension.js",
  "publisher": "Nguyen-Hong-Dat",
  "contributes": {
    "menus": {
      "editor/context": [
        {
          "command": "my-fbo-toolkit.openWithVS2008",
          "group": "fbo"
        },
        {
          "command": "fbo-autocomplete.ApplyTranslateFBO",
          "group": "fbo"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fbo-autocomplete.translatePaste",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "my-fbo-toolkit.openWithVS2008",
        "title": "Open With VS 2008"
      },
      {
        "command": "fbo-autocomplete.ApplyTranslateFBO",
        "title": "Apply Translate FBO (v -> e)"
      },
      {
        "command": "fbo-autocomplete.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "fbo-autocomplete.applyCompletionItem",
        "title": "zlkqlksk"
      },
      {
        "command": "fbo-autocomplete.renderXmlTodDB",
        "title": "Render XML To Database"
      },
      {
        "command": "fbo-autocomplete.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "fbo-autocomplete.applyCompletionItem",
        "title": "zlkqlksk"
      },
      {
        "command": "fbo-autocomplete.renderXmlTodDB",
        "title": "Render XML To Database"
      },
      {
        "command": "fbo-autocomplete.showEntityCodeLens",
        "title": "Show/Hide Entity CodeLens"
      },
      {
        "command": "fbo-autocomplete.getDataAutocomplete",
        "title": "Get Data Autocomplete"
      }
    ],
    "languages": [
      {
        "id": "xml",
        "aliases": [
          "XML",
          "xml"
        ],
        "extensions": [
          ".xml"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "updateUrl": "https://github.com/nguyenhongdat09/fbo-autocomplete/blob/company/update.json",
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "fast-xml-parser": "^4.5.1",
    "googleapis": "^144.0.0",
    "googletrans": "^1.0.21",
    "level-rocksdb": "^5.0.0",
    "rocksdb": "^5.2.1"
  }
}
