{
  "name": "fbo-autocomplete",
  "displayName": "fbo-autocomplete",
  "description": "Complete the code xml base on my own experience",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:xml" 
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "fbo-autocomplete.helloWorld",
      "title": "Hello World"
    }
  ],
  "languages": [
    {
      "id": "xml",
      "aliases": ["XML", "xml"],
      "extensions": [".xml"],
      "configuration":"./language-configuration.json"
    }

  ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.16.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
